{
  "type": "plugin",
  "id": "org.edgeever.tasks",
  "name": "Tasks",
  "version": "0.6.7",
  "apiVersion": "2",
  "settingsUi": "host",
  "description": "Collects Markdown tasks across notes and links every task back to its source.",
  "locales": {
    "zh-CN": {
      "name": "待办任务",
      "description": "汇总所有笔记中的 Markdown 任务，并将每项任务链接回原笔记。"
    },
    "ja": {
      "name": "タスク",
      "description": "ノート内の Markdown タスクをまとめ、各タスクから元のノートへ移動できるようにします。"
    }
  },
  "author": "tianma-if",
  "entry": "./main.js",
  "platforms": [
    "web",
    "desktop"
  ],
  "settings": {
    "fields": [
      {
        "key": "global-filter",
        "type": "text",
        "label": "Global filter",
        "placeholder": "#task",
        "locales": {
          "zh-CN": {
            "label": "全局筛选"
          },
          "ja": {
            "label": "グローバルフィルター"
          }
        }
      },
      {
        "key": "task-format",
        "type": "select",
        "label": "Task metadata format",
        "default": "dataview",
        "options": [
          {
            "value": "dataview",
            "label": "Text fields [due:: YYYY-MM-DD]"
          },
          {
            "value": "emoji",
            "label": "Obsidian Tasks emoji (📅)"
          }
        ],
        "locales": {
          "zh-CN": {
            "label": "任务元数据格式",
            "options": {
              "dataview": "文本字段 [due:: YYYY-MM-DD]",
              "emoji": "Obsidian Tasks 表情符号（📅）"
            }
          },
          "ja": {
            "label": "タスクのメタデータ形式",
            "options": {
              "dataview": "テキスト項目 [due:: YYYY-MM-DD]",
              "emoji": "Obsidian Tasks の絵文字（📅）"
            }
          }
        }
      },
      {
        "key": "set-done-date",
        "type": "boolean",
        "label": "Write done date on completion",
        "default": true,
        "locales": {
          "zh-CN": {
            "label": "完成时写入完成日期"
          },
          "ja": {
            "label": "完了時に完了日を書き込む"
          }
        }
      },
      {
        "key": "set-cancelled-date",
        "type": "boolean",
        "label": "Write cancelled date",
        "default": true,
        "locales": {
          "zh-CN": {
            "label": "取消时写入取消日期"
          },
          "ja": {
            "label": "キャンセル時に日付を書き込む"
          }
        }
      },
      {
        "key": "set-created-date",
        "type": "boolean",
        "label": "Write created date on new tasks",
        "default": false,
        "locales": {
          "zh-CN": {
            "label": "新建任务时写入创建日期"
          },
          "ja": {
            "label": "新規タスクに作成日を書き込む"
          }
        }
      },
      {
        "key": "recurrence-insert",
        "type": "select",
        "label": "Next recurring task",
        "default": "before",
        "options": [
          {
            "value": "before",
            "label": "Insert above the completed task"
          },
          {
            "value": "after",
            "label": "Insert below the completed task"
          }
        ],
        "locales": {
          "zh-CN": {
            "label": "下一个重复任务",
            "options": {
              "before": "插入到已完成任务上方",
              "after": "插入到已完成任务下方"
            }
          },
          "ja": {
            "label": "次の繰り返しタスク",
            "options": {
              "before": "完了したタスクの上に挿入",
              "after": "完了したタスクの下に挿入"
            }
          }
        }
      }
    ]
  },
  "permissions": [
    "notes:read",
    "notes:write",
    "editor:read",
    "editor:write",
    "storage",
    "ui:commands",
    "ui:navigation",
    "ui:notices",
    "ui:panels"
  ]
}
